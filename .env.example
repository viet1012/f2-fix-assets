# Dev: BE mà proxy /api chuyển tới. Mặc định http://localhost:8080.
# Dev với BE trên server: tạo .env.local và đặt VITE_PROXY_TARGET=http://192.168.122.16:9097
VITE_PROXY_TARGET=http://localhost:8080

# Để TRỐNG: FE gọi /api cùng origin (dev qua proxy, deploy qua nginx).
VITE_API_BASE_URL=

# (tuỳ chọn) Phiên bản hiển thị ở footer trang đăng nhập
VITE_APP_VERSION=1.0.0